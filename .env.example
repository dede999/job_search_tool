# Copy to .env and fill in what you need (this file is loaded by app/main.py
# and app/ai_evaluate.py via python-dotenv). .env itself is gitignored.

# Required only for the AI evaluation step (app/ai_evaluate.py). Talks to
# any OpenAI-compatible chat-completions API — OpenAI itself, Groq, a local
# router, etc. — so swapping providers/models is just an env var change.
LLM_API_KEY=...
LLM_MODEL=...
# LLM_BASE_URL=https://api.groq.com/openai/v1   # omit to use api.openai.com

# Required only if you enable an Adzuna entry in aggregators.yaml.
# Free signup at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
